@* ~/Areas/Admin/Views/Fines/FineIndex.cshtml: *@

@model IEnumerable<LibraryManagementSystem.Models.ViewModels.FineVM>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cərimələr";
    string sortOrder = ViewBag.SortOrder;
    string status = ViewBag.Status;
    string reason = ViewBag.Reason;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalFines = ViewBag.TotalFines;
    decimal totalAmount = ViewBag.TotalAmount;
    decimal totalUnpaidAmount = ViewBag.TotalUnpaidAmount;
    bool hasFilter = status != "" || reason != "";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <h1 class="content-title">Cərimələr</h1>

        <!-- CONTENT-FILTER START -->
        <div class="content-filter">
            <form asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" method="get">
                <select id="sortOrder" name="sortOrder" class="content-filter-select" onchange="this.form.submit()">
                    <option value="date_desc" selected="@(sortOrder == "date_desc")">Yenidən köhnəyə</option>
                    <option value="date_asc" selected="@(sortOrder == "date_asc")">Köhnədən yeniyə</option>
                    <option value="amount_desc" selected="@(sortOrder == "amount_desc")">Məbləğ: çoxdan aza</option>
                    <option value="amount_asc" selected="@(sortOrder == "amount_asc")">Məbləğ: azdan çoxa</option>
                </select>

                <select id="status" name="status" class="content-filter-select" onchange="this.form.submit()">
                    <option value="" selected="@(status == "")">Ödəniş vəziyyəti</option>
                    <option value="unpaid" selected="@(status == "unpaid")">Ödənilməyib</option>
                    <option value="paid" selected="@(status == "paid")">Ödənilib</option>
                </select>

                <select id="reason" name="reason" class="content-filter-select" onchange="this.form.submit()">
                    <option value="" selected="@(reason == "")">Cərimənin səbəbi</option>
                    <option value="late" selected="@(reason == "late")">Gecikir</option>
                    <option value="lost" selected="@(reason == "lost")">İtirilib</option>
                </select>

                @if (hasFilter)
                {
                    <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" asp-route-sortOrder="@sortOrder" class="btn-clear-filter" title="Filtrləri təmizlə">
                        <i class="fa-solid fa-xmark"></i>
                        <span>Təmizlə</span>
                    </a>
                }
            </form>
        </div>
        <!-- CONTENT-FILTER END -->

        <!-- BTN-CREATE START -->
        <a class="btn-create" asp-area="Admin" asp-controller="Fines" asp-action="FineCreate">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Cərimə</span>
        </a>
        <!-- BTN-CREATE END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- Ümumi cərimə sayı və məbləğləri -->
    <div class="content-total">
        <i class="fa-solid fa-money-bill-wave"></i>
        Ümumi cərimə sayı: @totalFines | Cəmi məbləğ: @totalAmount.ToString("0.00") AZN | Ödənilməmiş cərimələrin cəmi: @totalUnpaidAmount.ToString("0.00") AZN
    </div>

    <!-- Uğur və xəta mesajları (Success, DeleteError, Error): -->
    <partial name="_Messages" />

    <!-- CONTENT-LIST START -->
    <div class="content-list">
        @if (Model != null && Model.Any())
        {
            foreach (var fine in Model)
            {
                string statusClass = fine.FineIsPaid ? "active" : "overdue";
                <!-- CONTENT-CARD START -->
                <div class="content-card">
                    <!-- CONTENT-INFO START -->
                    <div class="content-info">
                        <!-- CONTENT-IMAGE START -->
                        <div class="content-image">
                            <i class="fa-solid fa-money-bill-wave"></i>
                        </div>
                        <!-- CONTENT-IMAGE END -->

                        <!-- CONTENT-NAME-AREA START -->
                        <div class="content-name-area">
                            <span class="content-label">Cərimə</span>

                            <h2 class="content-name">@fine.BookName</h2>

                            <span class="content-isbn">
                                İstifadəçi: @fine.UserFullName (@fine.UserUsername)
                            </span>

                            <span class="content-user-count">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                @fine.FineReason — @fine.FineAmount.ToString("0.00") AZN
                            </span>
                        </div>
                        <!-- CONTENT-NAME-AREA END -->
                    </div>
                    <!-- CONTENT-INFO END -->

                    <!-- CONTENT-ACTIONS START -->
                    <div class="content-actions">
                        <!-- STATUS START -->
                        <span class="status-is-active @statusClass">@fine.FineStatus</span>
                        <!-- STATUS END -->

                        <!-- BTN-DETAILS (popup-ı açan button) START -->
                        <button type="button" class="btn-details" title="Ətraflı məlumat"
                                data-fine-id="@fine.FineId"
                                data-fine-user-full-name="@fine.UserFullName"
                                data-fine-user-username="@fine.UserUsername"
                                data-fine-book-name="@fine.BookName"
                                data-fine-book-isbn="@fine.BookIsbn"
                                data-fine-reason="@fine.FineReason"
                                data-fine-amount="@(fine.FineAmount.ToString("0.00") + " AZN")"
                                data-fine-date="@fine.FineDate.ToString("dd.MM.yyyy HH:mm")"
                                data-fine-status="@fine.FineStatus"
                                data-fine-payment-date="@(fine.FinePaymentDate.HasValue ? fine.FinePaymentDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")"
                                data-fine-borrow-date="@fine.BorrowDate.ToString("dd.MM.yyyy HH:mm")"
                                data-fine-borrow-due-date="@fine.BorrowDueDate.ToString("dd.MM.yyyy")"
                                data-fine-borrow-return-date="@(fine.BorrowReturnDate.HasValue ? fine.BorrowReturnDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")">

                            <i class="fa-solid fa-eye"></i>

                        </button>
                        <!-- BTN-DETAILS (popup-ı açan button) END -->

                        @if (!fine.FineIsPaid)
                        {
                            <!-- BTN-PAY START -->
                            <a asp-area="Admin" asp-controller="Fines" asp-action="FinePay" asp-route-id="@fine.FineId" class="btn-edit" title="Ödənilmiş kimi qeyd et">
                                <i class="fa-solid fa-hand-holding-dollar"></i>
                                <span>Ödənildi</span>
                            </a>
                            <!-- BTN-PAY END -->

                            <!-- BTN-EDIT START -->
                            <a asp-area="Admin" asp-controller="Fines" asp-action="FineEdit" asp-route-id="@fine.FineId" class="btn-edit" title="Məbləği dəyiş">
                                <i class="fa-solid fa-pen"></i>
                                <span>Redaktə Et</span>
                            </a>
                            <!-- BTN-EDIT END -->

                            <!-- BTN-DELETE START -->
                            <a asp-area="Admin" asp-controller="Fines" asp-action="FineDelete" asp-route-id="@fine.FineId" class="btn-delete" title="Sil">
                                <i class="fa-solid fa-trash"></i>
                                <span>Sil</span>
                            </a>
                            <!-- BTN-DELETE END -->
                        }
                    </div>
                    <!-- CONTENT-ACTIONS END -->
                </div>
                <!-- CONTENT-CARD END -->
            }
        }
        else
        {
            <div class="empty-message">
                <i class="fa-solid fa-money-bill-wave"></i>
                <span>Heç bir cərimə tapılmadı!</span>
            </div>
        }
    </div>
    <!-- CONTENT-LIST END -->

    <!-- PAGINATION START -->
    <partial name="_Pagination" model="@(new PaginationVM
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        PageUrl = p => Url.Action("FineIndex", "Fines", new { area = "Admin", page = p, sortOrder, status, reason })!
    })" />
    <!-- PAGINATION END -->
</div>
<!-- CONTENT-CONTAINER END -->

<!-- CONTENT-MODAL START -->
<div class="content-modal" id="fineModal">
    <div class="modal-container" id="modalContainer"></div>

    <!-- CONTENT-POPUP START -->
    <div class="content-popup">
        <!-- POPUP-HEADER START -->
        <div class="popup-header">
            <div class="popup-title-area">
                <div class="popup-icon">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>

                <div>
                    <span class="popup-label">Cərimə məlumatları</span>
                    <h2 id="popupFineTitle">Cərimə</h2>
                </div>
            </div>

            <button type="button" class="popup-close" id="popupClose" title="Bağla">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <!-- POPUP-HEADER END -->

        <!-- POPUP-BODY START (cərimələrin şəkli olmadığı üçün tək sütun) -->
        <div class="popup-body" style="grid-template-columns: 1fr;">
            <!-- POPUP-DETAILS START -->
            <div class="popup-details">
                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-hashtag"></i> Cərimə ID</span>
                    <span class="detail-value" id="popupFineId">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-user"></i> İstifadəçi</span>
                    <span class="detail-value" id="popupFineUserFullName">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-at"></i> İstifadəçi adı</span>
                    <span class="detail-value" id="popupFineUserUsername">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-book"></i> Kitab</span>
                    <span class="detail-value" id="popupFineBookName">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-barcode"></i> ISBN</span>
                    <span class="detail-value" id="popupFineBookIsbn">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-circle-exclamation"></i> Cərimənin səbəbi</span>
                    <span class="detail-value" id="popupFineReason">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-money-bill"></i> Cərimə məbləği</span>
                    <span class="detail-value" id="popupFineAmount">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-circle-check"></i> Status</span>
                    <span class="detail-value">
                        <span id="popupFineStatus" class="popup-is-active">-</span>
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-calendar-plus"></i> Cərimənin yaranma tarixi</span>
                    <span class="detail-value" id="popupFineDate">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-calendar-check"></i> Ödəniş tarixi</span>
                    <span class="detail-value" id="popupFinePaymentDate">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-calendar-plus"></i> İcarə tarixi</span>
                    <span class="detail-value" id="popupFineBorrowDate">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-calendar-day"></i> Qaytarılma müddəti</span>
                    <span class="detail-value" id="popupFineBorrowDueDate">-</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label"><i class="fa-solid fa-calendar-check"></i> Qaytarılma tarixi</span>
                    <span class="detail-value" id="popupFineBorrowReturnDate">-</span>
                </div>
            </div>
            <!-- POPUP-DETAILS END -->
        </div>
        <!-- POPUP-BODY END -->
    </div>
    <!-- CONTENT-POPUP END -->
</div>
<!-- CONTENT-MODAL END -->

@section Scripts
{
    <script src="~/AdminControllerJSs/FineIndex.js"></script>
}

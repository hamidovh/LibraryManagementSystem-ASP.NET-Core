@* ~/Areas/Admin/Views/Roles/RoleEdit.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.RoleVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rolu Redaktə Et";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-user-shield"></i>
            </div>

            <div>
                <span class="content-label">Rollar</span>
                <h1 class="content-title">Rolu Redaktə Et</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Roles" asp-action="RoleIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <partial name="_Messages" />

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Roles" asp-action="RoleEdit" asp-route-id="@Model.RoleId" method="post" class="transaction-form">
        <!-- Rol ID-si POST zamanı modelə göndərilir: -->
        <input asp-for="RoleId" type="hidden" />

        <!-- Controller-dən gələn "Heç bir dəyişiklik edilməyib!" xəbərdarlığı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-user-shield"></i>
                <span>Rol məlumatları</span>
            </div>

            <div class="form-group">
                <label asp-for="RoleName" class="form-label">Rol adı:</label>
                <input asp-for="RoleName" class="form-input" placeholder="Rol adını daxil edin..." />
                <span asp-validation-for="RoleName" class="validation-message"></span>
            </div>

            <div class="form-group form-group-inline">
                <label asp-for="RoleIsActive" class="form-label">Status:</label>
                <label class="status-checkbox">
                    <input asp-for="RoleIsActive" />
                    <span>Aktiv</span>
                </label>
                <span asp-validation-for="RoleIsActive" class="validation-message"></span>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Roles" asp-action="RoleIndex" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i>
                <span>Ləğv et</span>
            </a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Dəyişiklikləri yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

@* ~/Areas/Admin/Views/Books/BookCreate.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.BookVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Kitab";
    var authors = ViewBag.Authors as List<LibraryManagementSystem.Data.Entities.TblAuthor>;
    var categories = ViewBag.Categories as List<LibraryManagementSystem.Data.Entities.TblCategory>;
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-book"></i>
            </div>
            <div>
                <span class="content-label">Kİtablar</span>
                <h1 class="content-title">Yeni Kitab</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Books" asp-action="BookIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Books" asp-action="BookCreate" method="post" enctype="multipart/form-data" class="transaction-form">
        <!-- Controller-dən gələn xəta mesajı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-book"></i>
                <span>Kitab məlumatları</span>
            </div>

            <div class="form-group">
                <label asp-for="BookName" class="form-label">Kitab adı:</label>
                <input asp-for="BookName" class="form-input" placeholder="Kitab adını daxil edin..." />
                <span asp-validation-for="BookName" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="BookIsbn" class="form-label">ISBN:</label>
                <input asp-for="BookIsbn" class="form-input" placeholder="Kitabın ISBN kodunu daxil edin..." />
                <span asp-validation-for="BookIsbn" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="BookAbout" class="form-label">Kitab haqqında:</label>
                <textarea asp-for="BookAbout" class="form-textarea" placeholder="Kitab haqqında məlumat daxil edin..."></textarea>
                <span asp-validation-for="BookAbout" class="validation-message"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="SelectedAuthorIds" class="form-label">Müəlliflər:</label>
                    <select asp-for="SelectedAuthorIds" class="form-select multiselect" multiple data-searchable data-placeholder="Müəllif seçin...">
                        @if (authors != null)
                        {
                            foreach (var author in authors)
                            {
                                <option value="@author.AuthorId">@author.AuthorName @author.AuthorSurname</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SelectedAuthorIds" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SelectedCategoryIds" class="form-label">Kateqoriyalar:</label>
                    <select asp-for="SelectedCategoryIds" class="form-select multiselect" multiple data-searchable data-placeholder="Kateqoriya seçin...">
                        @if (categories != null)
                        {
                            foreach (var category in categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SelectedCategoryIds" class="validation-message"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="BookStockQuantity" class="form-label">Stok miqdarı:</label>
                    <input asp-for="BookStockQuantity" type="number" min="0" class="form-input" placeholder="Mövcud kitab sayını daxil edin..." />
                    <span asp-validation-for="BookStockQuantity" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BookFineAmount" class="form-label">Cərimə məbləği:</label>
                    <input asp-for="BookFineAmount" type="number" min="0" step="0.01" class="form-input" placeholder="Cərimə məbləğini daxil edin..." />
                    <span class="input-info">AZN / gün</span>
                    <span asp-validation-for="BookFineAmount" class="validation-message"></span>
                </div>
            </div>

            <div class="form-group form-group-inline">
                <label asp-for="BookIsActive" class="form-label">Status:</label>
                <label class="status-checkbox">
                    <input asp-for="BookIsActive" />
                    <span>Aktiv</span>
                </label>
                <span asp-validation-for="BookIsActive" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile" class="form-label">Kitab şəkli:</label>
                <input asp-for="ImageFile" type="file" class="form-file" accept=".jpg,.jpeg,.png,.webp" />
                <span class="file-info">JPG, JPEG, PNG və WEBP — maksimum 5 MB!</span>
                <span asp-validation-for="ImageFile" class="validation-message"></span>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Books" asp-action="BookIndex" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i>
                <span>Ləğv et</span>
            </a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/AdminControllerJSs/MultiSelect.js"></script>
}

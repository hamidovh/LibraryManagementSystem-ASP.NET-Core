@* ~/Areas/Admin/Views/Borrows/BorrowReturn.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.BorrowVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kitabı Qaytar";
    string statusClass = Model.BorrowStatus == "Gecikir" ? "overdue" : "active";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Delete.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div>
                <span class="content-label">İcarələr</span>
                <h1 class="content-title">Kitabı Qaytar</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Borrows" asp-action="BorrowIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Borrows" asp-action="BorrowReturn" asp-route-id="@Model.BorrowId" method="post" class="transaction-form">
        <!-- FORM-SECTION START -->
        <div class="form-section">
            <!-- DELETE-WARNING START -->
            <div class="delete-warning">
                <div class="warning-icon">
                    <i class="fa-solid fa-rotate-left"></i>
                </div>

                <div class="warning-content">
                    <h2>Kitabın qaytarıldığını təsdiqləyirsiniz?</h2>
                    <p>Qaytarılma tarixi olaraq indiki vaxt qeyd olunacaq. Bu əməliyyatdan sonra icarə redaktə edilə bilməyəcək!</p>
                </div>
            </div>
            <!-- DELETE-WARNING END -->

            <!-- CONTENT-DATA START (icarələrin şəkli olmadığı üçün tək sütun) -->
            <div class="content-data" style="grid-template-columns: 1fr;">
                <!-- CONTENT-DETAILS START -->
                <div class="content-details">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-hashtag"></i>
                            İcarə ID
                        </span>

                        <span class="detail-value">
                            @Model.BorrowId
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-user"></i>
                            İstifadəçi
                        </span>

                        <span class="detail-value">
                            @Model.UserFullName (@Model.UserUsername)
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-book"></i>
                            Kitab
                        </span>

                        <span class="detail-value">
                            @Model.BookName
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-barcode"></i>
                            ISBN
                        </span>

                        <span class="detail-value">
                            @Model.BookIsbn
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar-plus"></i>
                            İcarə tarixi
                        </span>

                        <span class="detail-value">
                            @Model.BorrowDate.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar-day"></i>
                            Qaytarılma müddəti
                        </span>

                        <span class="detail-value">
                            @Model.BorrowDueDate.ToString("dd.MM.yyyy")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-circle-check"></i>
                            Status
                        </span>

                        <span class="detail-value">
                            <span class="status-is-active @statusClass">@Model.BorrowStatus</span>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-hourglass-half"></i>
                            Gecikmə (gün)
                        </span>

                        <span class="detail-value">
                            @Model.LateDays
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-money-bill"></i>
                            Hesablanmış cərimə
                        </span>

                        <span class="detail-value">
                            @Model.FinePreview.ToString("0.00") AZN
                        </span>
                    </div>
                </div>
                <!-- CONTENT-DETAILS END -->
            </div>
            <!-- CONTENT-DATA END -->

            <!-- DELETE-MESSAGE START -->
            <div class="delete-message">
                <i class="fa-solid fa-circle-info"></i>
                @if (Model.LateDays > 0 && Model.FinePreview > 0)
                {
                    <span>Gecikmə mövcuddur, təsdiq etdikdən sonra @Model.FinePreview.ToString("0.00") AZN məbləğində cərimə yaradılacaq!</span>
                }
                else
                {
                    <span>Gecikmə yoxdur, cərimə yaradılmayacaq.</span>
                }
            </div>
            <!-- DELETE-MESSAGE END -->
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Borrows" asp-action="BorrowIndex" class="btn-cancel">Ləğv et</a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Qaytarılmanı təsdiqlə</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

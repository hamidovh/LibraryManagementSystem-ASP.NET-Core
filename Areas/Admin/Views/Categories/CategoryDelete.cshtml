@* ~/Areas/Admin/Views/Categories/CategoryDelete.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.CategoryVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kateqoriyanı Sil";
    var currentImage = Model.TblCategoryImages?.OrderBy(i => i.ImageSortOrder).FirstOrDefault();
    string? imagePath = null;
    if (currentImage != null && !string.IsNullOrWhiteSpace(currentImage.ImagePath))
    {
        imagePath = Url.Content("~/Uploads/" + currentImage.ImagePath);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Images.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Delete.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div>
                <span class="content-label">Kateqorİyalar</span>
                <h1 class="content-title">Kateqoriyanı Sil</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Categories" asp-action="CategoryIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Categories" asp-action="CategoryDelete" asp-route-id="@Model.CategoryId" method="post" class="transaction-form">
        <!-- FORM-SECTION START -->
        <div class="form-section">
            <!-- DELETE-WARNING START -->
            <div class="delete-warning">
                <div class="warning-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="warning-content">
                    <h2>Kateqoriyanı silmək istədiyinizdən əminsiniz?</h2>
                    <p>Bu əməliyyat geri qaytarıla bilməz! Kateqoriyanı silməzdən əvvəl məlumatları yoxlayın.</p>
                </div>
            </div>
            <!-- DELETE-WARNING END -->

            <!-- CONTENT-DATA START -->
            <div class="content-data">
                <!-- IMAGE-BOX START -->
                <div class="image-box">                    
                    @if (!string.IsNullOrWhiteSpace(imagePath))
                    {
                        <div class="current-image">
                            <img src="@imagePath" alt="@Model.CategoryName" />
                        </div>
                    }
                    else
                    {
                        <div class="no-image">
                            <i class="fa-solid fa-image"></i>
                            <span>Şəkil yoxdur</span>
                        </div>
                    }
                </div>
                <!-- IMAGE-BOX END -->

                <!-- CONTENT-DETAILS START -->
                <div class="content-details">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-hashtag"></i>
                            Kateqoriya ID
                        </span>

                        <span class="detail-value">
                            @Model.CategoryId
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-layer-group"></i>
                            Kateqoriya adı
                        </span>

                        <span class="detail-value">
                            @Model.CategoryName
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-align-left"></i>
                            Kateqoriya haqqında
                        </span>

                        <span class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.CategoryDescription) ? "-" : Model.CategoryDescription)
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-circle-check"></i>
                            Status
                        </span>

                        <span class="detail-value">
                            @if (Model.CategoryIsActive)
                            {
                                <span class="status-is-active active">Aktiv</span>
                            }
                            else
                            {
                                <span class="status-is-active deactive">Deaktiv</span>
                            }
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar"></i>
                            Yaradılma tarixi
                        </span>

                        <span class="detail-value">
                            @Model.CategoryCreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar"></i>
                            Son yenilənmə tarixi
                        </span>

                        <span class="detail-value">
                            @(Model.CategoryUpdatedDate.HasValue ? Model.CategoryUpdatedDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                        </span>
                    </div>
                </div>
                <!-- CONTENT-DETAILS END -->
            </div>
            <!-- CONTENT-DATA END -->

            <!-- DELETE-MESSAGE START -->
            <div class="delete-message">
                <i class="fa-solid fa-circle-info"></i>
                <span>Kateqoriyaya bağlı kitablar mövcuddursa, kateqoriya silinməyəcək!</span>
            </div>
            <!-- DELETE-MESSAGE END -->
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Categories" asp-action="CategoryIndex" class="btn-cancel">Ləğv et</a>

            <button type="submit" class="btn-delete">
                <i class="fa-solid fa-trash"></i>
                <span>Kateqoriyanı sil</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

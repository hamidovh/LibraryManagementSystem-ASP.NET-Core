@* ~/Areas/Admin/Views/Fines/FineEdit.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.FineVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cəriməni Redaktə Et";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>

            <div>
                <span class="content-label">Cərimələr</span>
                <h1 class="content-title">Cəriməni Redaktə Et</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <partial name="_Messages" />

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Fines" asp-action="FineEdit" asp-route-id="@Model.FineId" method="post" class="transaction-form">
        <!-- Cərimə ID-si POST zamanı modelə göndərilir: -->
        <input asp-for="FineId" type="hidden" />

        <!-- Controller-dən gələn "Heç bir dəyişiklik edilməyib!" xəbərdarlığı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-money-bill-wave"></i>
                <span>Cərimə məlumatları</span>
            </div>

            <!-- İstifadəçi, kitab, səbəb və tarix dəyişdirilə bilmir (disabled sahələr POST olunmur): -->
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">İstifadəçi:</label>
                    <input class="form-input" value="@Model.UserFullName (@Model.UserUsername)" disabled />
                </div>

                <div class="form-group">
                    <label class="form-label">Kitab:</label>
                    <input class="form-input" value="@Model.BookName (ISBN: @Model.BookIsbn)" disabled />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Cərimənin səbəbi:</label>
                    <input class="form-input" value="@Model.FineReason" disabled />
                </div>

                <div class="form-group">
                    <label class="form-label">Cərimənin yaranma tarixi:</label>
                    <input class="form-input" value="@Model.FineDate.ToString("dd.MM.yyyy HH:mm")" disabled />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="FineAmount" class="form-label">Cərimə məbləği:</label>
                <input asp-for="FineAmount" type="number" min="0.01" step="0.01" value="@Model.FineAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-input" placeholder="Cərimə məbləğini daxil edin..." />
                <span class="input-info">AZN. Yalnız ödənilməmiş cəriminin məbləğini dəyişmək olar.</span>
                <span asp-validation-for="FineAmount" class="validation-message"></span>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i>
                <span>Ləğv et</span>
            </a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Dəyişiklikləri yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

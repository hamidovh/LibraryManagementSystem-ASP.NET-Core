@* ~/Areas/Admin/Views/Shared/_Pagination.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.PaginationVM

@if (Model.TotalPages > 1)
{
    int start = Math.Max(1, Model.CurrentPage - 2);
    int end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    <div class="pagination-container">
        @* Əvvəlki səhifə düyməsi: *@
        @if (Model.CurrentPage > 1)
        {
            <a class="pagination-btn" href="@Model.PageUrl(Model.CurrentPage - 1)" title="Əvvəlki səhifə">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
        }

        @if (start > 1)
        {
            <a class="pagination-btn" href="@Model.PageUrl(1)">1</a>
            if (start > 2)
            {
                <span class="pagination-dots">...</span>
            }
        }

        @* Səhifə nömrələri *@
        @for (int i = start; i <= end; i++)
        {
            <a class="pagination-btn @(i == Model.CurrentPage ? "active" : "")" href="@Model.PageUrl(i)">@i</a>
        }

        @if (end < Model.TotalPages)
        {
            if (end < Model.TotalPages - 1)
            {
                <span class="pagination-dots">...</span>
            }
            <a class="pagination-btn" href="@Model.PageUrl(Model.TotalPages)">@Model.TotalPages</a>
        }

        @* Növbəti səhifə düyməsi: *@
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a class="pagination-btn" href="@Model.PageUrl(Model.CurrentPage + 1)" title="Növbəti səhifə">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        }
    </div>
}


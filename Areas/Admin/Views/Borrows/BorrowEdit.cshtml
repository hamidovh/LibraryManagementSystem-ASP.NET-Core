@* ~/Areas/Admin/Views/Borrows/BorrowEdit.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.BorrowVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "İcarəni Redaktə Et";
    string minDate = Model.BorrowDate.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div>
                <span class="content-label">İcarələr</span>
                <h1 class="content-title">İcarəni Redaktə Et</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Borrows" asp-action="BorrowIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <partial name="_Messages" />

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Borrows" asp-action="BorrowEdit" asp-route-id="@Model.BorrowId" method="post" class="transaction-form">
        <!-- İcarə ID-si POST zamanı modelə göndərilir: -->
        <input asp-for="BorrowId" type="hidden" />

        <!-- Controller-dən gələn "Heç bir dəyişiklik edilməyib!" xəbərdarlığı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-book-open-reader"></i>
                <span>İcarə məlumatları</span>
            </div>

            <!-- İstifadəçi, kitab və icarə tarixi dəyişdirilə bilmir (disabled sahələr POST olunmur): -->
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">İstifadəçi:</label>
                    <input class="form-input" value="@Model.UserFullName (@Model.UserUsername)" disabled />
                </div>

                <div class="form-group">
                    <label class="form-label">Kitab:</label>
                    <input class="form-input" value="@Model.BookName (ISBN: @Model.BookIsbn)" disabled />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">İcarə tarixi:</label>
                    <input class="form-input" value="@Model.BorrowDate.ToString("dd.MM.yyyy HH:mm")" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="BorrowDueDate" class="form-label">Qaytarılma müddəti:</label>
                    <input asp-for="BorrowDueDate" type="date" min="@minDate" value="@Model.BorrowDueDate.ToString("yyyy-MM-dd")" class="form-input" style="color-scheme: dark;" />
                    <span class="input-info">Müddəti uzatmaq və ya qısaltmaq olar. İcarə tarixindən əvvəl ola bilməz.</span>
                    <span asp-validation-for="BorrowDueDate" class="validation-message"></span>
                </div>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Borrows" asp-action="BorrowIndex" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i>
                <span>Ləğv et</span>
            </a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Dəyişiklikləri yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

@* ~/Areas/Admin/Views/Fines/FineDelete.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.FineVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cəriməni Sil";
    string statusClass = Model.FineIsPaid ? "active" : "overdue";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Delete.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>

            <div>
                <span class="content-label">Cərimələr</span>
                <h1 class="content-title">Cəriməni Sil</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Fines" asp-action="FineDelete" asp-route-id="@Model.FineId" method="post" class="transaction-form">
        <!-- FORM-SECTION START -->
        <div class="form-section">
            <!-- DELETE-WARNING START -->
            <div class="delete-warning">
                <div class="warning-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="warning-content">
                    <h2>Cəriməni silmək istədiyinizdən əminsiniz?</h2>
                    <p>Bu əməliyyat geri qaytarıla bilməz! Cəriməni silməzdən əvvəl məlumatları yoxlayın.</p>
                </div>
            </div>
            <!-- DELETE-WARNING END -->

            <!-- CONTENT-DATA START (cərimələrin şəkli olmadığı üçün tək sütun) -->
            <div class="content-data" style="grid-template-columns: 1fr;">
                <!-- CONTENT-DETAILS START -->
                <div class="content-details">
                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-hashtag"></i> Cərimə ID</span>
                        <span class="detail-value">@Model.FineId</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-user"></i> İstifadəçi</span>
                        <span class="detail-value">@Model.UserFullName (@Model.UserUsername)</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-book"></i> Kitab</span>
                        <span class="detail-value">@Model.BookName</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-barcode"></i> ISBN</span>
                        <span class="detail-value">@Model.BookIsbn</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-circle-exclamation"></i> Cərimənin səbəbi</span>
                        <span class="detail-value">@Model.FineReason</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-money-bill"></i> Cərimə məbləği</span>
                        <span class="detail-value">@Model.FineAmount.ToString("0.00") AZN</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-calendar-plus"></i> Cərimənin yaranma tarixi</span>
                        <span class="detail-value">@Model.FineDate.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-circle-check"></i> Status</span>
                        <span class="detail-value">
                            <span class="status-is-active @statusClass">@Model.FineStatus</span>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-calendar-check"></i> Ödəniş tarixi</span>
                        <span class="detail-value">@(Model.FinePaymentDate.HasValue ? Model.FinePaymentDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")</span>
                    </div>
                </div>
                <!-- CONTENT-DETAILS END -->
            </div>
            <!-- CONTENT-DATA END -->

            <!-- DELETE-MESSAGE START -->
            <div class="delete-message">
                <i class="fa-solid fa-circle-info"></i>
                <span>Ödənilmiş cərimə silinməyəcək!</span>
            </div>
            <!-- DELETE-MESSAGE END -->
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" class="btn-cancel">Ləğv et</a>

            <button type="submit" class="btn-delete">
                <i class="fa-solid fa-trash"></i>
                <span>Cəriməni sil</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

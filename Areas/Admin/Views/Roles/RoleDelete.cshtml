@* ~/Areas/Admin/Views/Roles/RoleDelete.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.RoleVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rolu Sil";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Delete.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-user-shield"></i>
            </div>

            <div>
                <span class="content-label">Rollar</span>
                <h1 class="content-title">Rolu Sil</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Roles" asp-action="RoleIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Roles" asp-action="RoleDelete" asp-route-id="@Model.RoleId" method="post" class="transaction-form">
        <!-- FORM-SECTION START -->
        <div class="form-section">
            <!-- DELETE-WARNING START -->
            <div class="delete-warning">
                <div class="warning-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="warning-content">
                    <h2>Rolu silmək istədiyinizdən əminsiniz?</h2>
                    <p>Bu əməliyyat geri qaytarıla bilməz! Rolu silməzdən əvvəl məlumatları yoxlayın.</p>
                </div>
            </div>
            <!-- DELETE-WARNING END -->

            <!-- CONTENT-DATA START (rolların şəkli olmadığı üçün tək sütun) -->
            <div class="content-data" style="grid-template-columns: 1fr;">
                <!-- CONTENT-DETAILS START -->
                <div class="content-details">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-hashtag"></i>
                            Rol ID
                        </span>

                        <span class="detail-value">
                            @Model.RoleId
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-user-shield"></i>
                            Rolun adı
                        </span>

                        <span class="detail-value">
                            @Model.RoleName
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-users"></i>
                            İstifadəçi sayı
                        </span>

                        <span class="detail-value">
                            @Model.UserCount
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-circle-check"></i>
                            Status
                        </span>

                        <span class="detail-value">
                            @if (Model.RoleIsActive)
                            {
                                <span class="status-is-active active">Aktiv</span>
                            }
                            else
                            {
                                <span class="status-is-active deactive">Deaktiv</span>
                            }
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar"></i>
                            Yaradılma tarixi
                        </span>

                        <span class="detail-value">
                            @Model.RoleCreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar"></i>
                            Son yenilənmə tarixi
                        </span>

                        <span class="detail-value">
                            @(Model.RoleUpdatedDate.HasValue ? Model.RoleUpdatedDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                        </span>
                    </div>
                </div>
                <!-- CONTENT-DETAILS END -->
            </div>
            <!-- CONTENT-DATA END -->

            <!-- DELETE-MESSAGE START -->
            <div class="delete-message">
                <i class="fa-solid fa-circle-info"></i>
                <span>Rola bağlı istifadəçilər mövcuddursa, rol silinməyəcək!</span>
            </div>
            <!-- DELETE-MESSAGE END -->
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Roles" asp-action="RoleIndex" class="btn-cancel">Ləğv et</a>

            <button type="submit" class="btn-delete">
                <i class="fa-solid fa-trash"></i>
                <span>Rolu sil</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@* ~/Areas/Admin/Views/Books/BookDelete.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.BookVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kitabı Sil";
    var currentImage = Model.TblBookImages?.OrderBy(i => i.ImageSortOrder).FirstOrDefault();
    string? imagePath = null;
    if (currentImage != null && !string.IsNullOrWhiteSpace(currentImage.ImagePath))
    {
        imagePath = Url.Content("~/Uploads/" + currentImage.ImagePath);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Images.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Delete.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-book"></i>
            </div>

            <div>
                <span class="content-label">Kİtablar</span>
                <h1 class="content-title">Kitabı Sil</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Books" asp-action="BookIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Books" asp-action="BookDelete" asp-route-id="@Model.BookId" method="post" class="transaction-form">
        <!-- FORM-SECTION START -->
        <div class="form-section">
            <!-- DELETE-WARNING START -->
            <div class="delete-warning">
                <div class="warning-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="warning-content">
                    <h2>Kitabı silmək istədiyinizdən əminsiniz?</h2>
                    <p>Bu əməliyyat geri qaytarıla bilməz! Kitabı silməzdən əvvəl məlumatları yoxlayın.</p>
                </div>
            </div>
            <!-- DELETE-WARNING END -->

            <!-- CONTENT-DATA START -->
            <div class="content-data">
                <!-- IMAGE-BOX START -->
                <div class="image-box">
                    @if (!string.IsNullOrWhiteSpace(imagePath))
                    {
                        <div class="current-image">
                            <img src="@imagePath" alt="@Model.BookName" />
                        </div>
                    }
                    else
                    {
                        <div class="no-image">
                            <i class="fa-solid fa-book"></i>
                            <span>Şəkil yoxdur</span>
                        </div>
                    }
                </div>
                <!-- IMAGE-BOX END -->

                <!-- CONTENT-DETAILS START -->
                <div class="content-details">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-hashtag"></i>
                            Kitab ID
                        </span>

                        <span class="detail-value">
                            @Model.BookId
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-book"></i>
                            Kitabın adı
                        </span>

                        <span class="detail-value">
                            @Model.BookName
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-barcode"></i>
                            ISBN
                        </span>

                        <span class="detail-value">
                            @Model.BookIsbn
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-align-left"></i>
                            Kitab haqqında
                        </span>

                        <span class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.BookAbout) ? "-" : Model.BookAbout)
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-user-pen"></i>
                            Müəllif(lər)
                        </span>

                        <span class="detail-value">
                            @(Model.Authors != null && Model.Authors.Any() ? string.Join(", ", Model.Authors.Select(a => a.AuthorName + " " + a.AuthorSurname)) : "-")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-layer-group"></i>
                            Kateqoriya(lar)
                        </span>

                        <span class="detail-value">
                            @(Model.Categories != null && Model.Categories.Any() ? string.Join(", ", Model.Categories.Select(c => c.CategoryName)) : "-")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-box"></i>
                            Stok miqdarı
                        </span>

                        <span class="detail-value">
                            @Model.BookStockQuantity
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-money-bill"></i>
                            Cərimə məbləği
                        </span>

                        <span class="detail-value">
                            @Model.BookFineAmount.ToString("0.00") AZN
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-circle-check"></i>
                            Status
                        </span>

                        <span class="detail-value">
                            @if (Model.BookIsActive)
                            {
                                <span class="status-is-active active">Aktiv</span>
                            }
                            else
                            {
                                <span class="status-is-active deactive">Deaktiv</span>
                            }
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar"></i>
                            Yaradılma tarixi
                        </span>

                        <span class="detail-value">
                            @Model.BookCreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar"></i>
                            Son yenilənmə tarixi
                        </span>

                        <span class="detail-value">
                            @(Model.BookUpdatedDate.HasValue ? Model.BookUpdatedDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                        </span>
                    </div>

                </div>
                <!-- CONTENT-DETAILS END -->
            </div>
            <!-- CONTENT-DATA END -->

            <!-- DELETE-MESSAGE START -->
            <div class="delete-message">
                <i class="fa-solid fa-circle-info"></i>
                <span>Kitab hazırda icarədədirsə və ya kitaba bağlı başqa məlumatlar mövcuddursa kitab silinməyəcək!</span>
            </div>
            <!-- DELETE-MESSAGE END -->
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Books" asp-action="BookIndex" class="btn-cancel">
                Ləğv et
            </a>

            <button type="submit" class="btn-delete">
                <i class="fa-solid fa-trash"></i>
                <span>Kitabı sil</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

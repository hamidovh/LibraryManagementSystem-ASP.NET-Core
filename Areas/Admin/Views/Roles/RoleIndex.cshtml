@* ~/Areas/Admin/Views/Roles/RoleIndex.cshtml: *@

@model IEnumerable<LibraryManagementSystem.Models.ViewModels.RoleVM>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rollar";
    string sortOrder = ViewBag.SortOrder;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <h1 class="content-title">Rollar</h1>

        <!-- CONTENT-FILTER START -->
        <div class="content-filter">
            <form asp-area="Admin" asp-controller="Roles" asp-action="RoleIndex" method="get">
                <select id="sortOrder" name="sortOrder" class="content-filter-select" onchange="this.form.submit()">
                    <option value="date_desc" selected="@(ViewBag.SortOrder == "date_desc")">Yenidən köhnəyə</option>
                    <option value="date_asc" selected="@(ViewBag.SortOrder == "date_asc")">Köhnədən yeniyə</option>
                    <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc")">A-dan Z-yə</option>
                    <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc")">Z-dən A-ya</option>
                </select>
            </form>
        </div>
        <!-- CONTENT-FILTER END -->

        <!-- BTN-CREATE START -->
        <a class="btn-create" asp-area="Admin" asp-controller="Roles" asp-action="RoleCreate">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Rol</span>
        </a>
        <!-- BTN-CREATE END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- Uğur və xəta mesajları (Success, DeleteError, Error): -->
    <partial name="_Messages" />

    <!-- CONTENT-LIST START -->
    <div class="content-list">
        @if (Model != null && Model.Any())
        {
            foreach (var role in Model)
            {
                <!-- CONTENT-CARD START -->
                <div class="content-card">
                    <!-- CONTENT-INFO START -->
                    <div class="content-info">
                        <!-- CONTENT-IMAGE START -->
                        <div class="content-image">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <!-- CONTENT-IMAGE END -->

                        <!-- CONTENT-NAME-AREA START -->
                        <div class="content-name-area">
                            <span class="content-label">Rol</span>

                            <h2 class="content-name">@role.RoleName</h2>

                            <span class="content-user-count">
                                <i class="fa-solid fa-users"></i>
                                İstifadəçi sayı: @role.UserCount
                            </span>
                        </div>
                        <!-- CONTENT-NAME-AREA END -->
                    </div>
                    <!-- CONTENT-INFO END -->

                    <!-- CONTENT-ACTIONS START -->
                    <div class="content-actions">
                        <!-- BTN-DETAILS (popup-ı açan button) START -->
                        <button type="button" class="btn-details" title="Ətraflı məlumat"
                                data-role-id="@role.RoleId"
                                data-role-name="@role.RoleName"
                                data-role-user-count="@role.UserCount"
                                data-role-is-active="@role.RoleIsActive"
                                data-role-created-date="@role.RoleCreatedDate.ToString("dd.MM.yyyy HH:mm")"
                                data-role-updated-date="@(role.RoleUpdatedDate.HasValue ? role.RoleUpdatedDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")">

                            <i class="fa-solid fa-eye"></i>

                        </button>
                        <!-- BTN-DETAILS (popup-ı açan button) END -->

                        <!-- BTN-EDIT START -->
                        <a asp-area="Admin" asp-controller="Roles" asp-action="RoleEdit" asp-route-id="@role.RoleId" class="btn-edit" title="Redaktə et">
                            <i class="fa-solid fa-pen"></i>
                            <span>Redaktə Et</span>
                        </a>
                        <!-- BTN-EDIT END -->

                        <!-- BTN-DELETE START -->
                        <a asp-area="Admin" asp-controller="Roles" asp-action="RoleDelete" asp-route-id="@role.RoleId" class="btn-delete" title="Sil">
                            <i class="fa-solid fa-trash"></i>
                            <span>Sil</span>
                        </a>
                        <!-- BTN-DELETE END -->
                    </div>
                    <!-- CONTENT-ACTIONS END -->
                </div>
                <!-- CONTENT-CARD END -->
            }
        }
        else
        {
            <div class="empty-message">
                <i class="fa-solid fa-folder-open"></i>
                <span>Heç bir rol tapılmadı!</span>
            </div>
        }
    </div>
    <!-- CONTENT-LIST END -->

    <!-- PAGINATION START -->
    <partial name="_Pagination" model="@(new PaginationVM
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        PageUrl = p => Url.Action("RoleIndex", "Roles", new { area = "Admin", page = p, sortOrder })!
    })" />
    <!-- PAGINATION END -->
</div>
<!-- CONTENT-CONTAINER END -->

<!-- CONTENT-MODAL START -->
<div class="content-modal" id="roleModal">
    <div class="modal-container" id="modalContainer"></div>

    <!-- CONTENT-POPUP START -->
    <div class="content-popup">
        <!-- POPUP-HEADER START -->
        <div class="popup-header">
            <div class="popup-title-area">
                <div class="popup-icon">
                    <i class="fa-solid fa-user-shield"></i>
                </div>

                <div>
                    <span class="popup-label">Rol məlumatları</span>
                    <h2 id="popupRoleTitle">Rol</h2>
                </div>
            </div>

            <button type="button" class="popup-close" id="popupClose" title="Bağla">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <!-- POPUP-HEADER END -->

        <!-- POPUP-BODY START (rolların şəkli olmadığı üçün şəkil sahəsi yoxdur və popup-body tək sütun olur:) -->
        <div class="popup-body" style="grid-template-columns: 1fr;">
            <!-- POPUP-DETAILS START -->
            <div class="popup-details">
                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-hashtag"></i>
                        Rol ID
                    </span>

                    <span class="detail-value" id="popupRoleId">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-user-shield"></i>
                        Rolun adı
                    </span>

                    <span class="detail-value" id="popupRoleName">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-users"></i>
                        İstifadəçi sayı
                    </span>

                    <span class="detail-value" id="popupRoleUserCount">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-circle-check"></i>
                        Status
                    </span>

                    <span class="detail-value">
                        <span id="popupRoleIsActive" class="popup-is-active">
                            -
                        </span>
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-calendar-plus"></i>
                        Yaradılma tarixi
                    </span>

                    <span class="detail-value" id="popupRoleCreatedDate">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-calendar-check"></i>
                        Son yenilənmə tarixi
                    </span>

                    <span class="detail-value" id="popupRoleUpdatedDate">
                        -
                    </span>
                </div>
            </div>
            <!-- POPUP-DETAILS END -->
        </div>
        <!-- POPUP-BODY END -->
    </div>
    <!-- CONTENT-POPUP END -->
</div>
<!-- CONTENT-MODAL END -->

@section Scripts
{    
    <script src="~/AdminControllerJSs/RoleIndex.js"></script>
}

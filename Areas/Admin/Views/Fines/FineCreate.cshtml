@* ~/Areas/Admin/Views/Fines/FineCreate.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.FineVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Cərimə";
    var borrows = ViewBag.Borrows as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var reasons = ViewBag.Reasons as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>

            <div>
                <span class="content-label">Cərimələr</span>
                <h1 class="content-title">Yeni Cərimə</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Fines" asp-action="FineCreate" method="post" class="transaction-form">
        <!-- Controller-dən gələn xəta mesajı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-money-bill-wave"></i>
                <span>Cərimə məlumatları</span>
            </div>

            <div class="form-group">
                <label asp-for="BorrowId" class="form-label">İcarə:</label>
                <select asp-for="BorrowId" asp-items="borrows" class="form-select multiselect" data-single data-searchable data-placeholder="İcarə seçin...">
                    <option value="0">İcarə seçin...</option>
                </select>
                <span class="input-info">Yalnız cəriməsi olmayan icarələr göstərilir (hər icarəyə maksimum 1 cərimə).</span>
                <span asp-validation-for="BorrowId" class="validation-message"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FineReason" class="form-label">Cərimənin səbəbi:</label>
                    <select asp-for="FineReason" asp-items="reasons" class="form-select" style="height: 45px; padding: 0 12px;"></select>
                    <span class="input-info">"İtirilib" seçilərsə icarə bağlanacaq və 1 nüsxə stokdan çıxarılacaq.</span>
                    <span asp-validation-for="FineReason" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FineAmount" class="form-label">Cərimə məbləği:</label>
                    <input asp-for="FineAmount" type="number" min="0.01" step="0.01" value="@(Model.FineAmount == 0 ? "" : Model.FineAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" class="form-input" placeholder="Cərimə məbləğini daxil edin..." />
                    <span class="input-info">AZN</span>
                    <span asp-validation-for="FineAmount" class="validation-message"></span>
                </div>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Fines" asp-action="FineIndex" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i>
                <span>Ləğv et</span>
            </a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/AdminControllerJSs/MultiSelect.js"></script>
}

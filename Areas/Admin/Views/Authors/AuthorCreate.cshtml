@* ~/Areas/Admin/Views/Authors/AuthorCreate.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.AuthorVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Müəllif";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-user-pen"></i>
            </div>

            <div>
                <span class="content-label">Müəllİflər</span>
                <h1 class="content-title">Yeni Müəllif</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Authors" asp-action="AuthorIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Authors" asp-action="AuthorCreate" method="post" enctype="multipart/form-data" class="transaction-form">
        <!-- Controller-dən gələn xəta mesajı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-user-pen"></i>
                <span>Müəllif məlumatları</span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="AuthorName" class="form-label">Müəllifin adı:</label>
                    <input asp-for="AuthorName" class="form-input" placeholder="Müəllifin adını daxil edin..." />
                    <span asp-validation-for="AuthorName" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AuthorSurname" class="form-label">Müəllifin soyadı:</label>
                    <input asp-for="AuthorSurname" class="form-input" placeholder="Müəllifin soyadını daxil edin..." />
                    <span asp-validation-for="AuthorSurname" class="validation-message"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="AuthorInfo" class="form-label">Müəllif haqqında:</label>
                <textarea asp-for="AuthorInfo" class="form-textarea" placeholder="Müəllif haqqında məlumat daxil edin..."></textarea>
                <span asp-validation-for="AuthorInfo" class="validation-message"></span>
            </div>

            <div class="form-group form-group-inline">
                <label asp-for="AuthorIsActive" class="form-label">Status:</label>
                <label class="status-checkbox">
                    <input asp-for="AuthorIsActive" />
                    <span>Aktiv</span>
                </label>
                <span asp-validation-for="AuthorIsActive" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile" class="form-label">Müəllif şəkli:</label>
                <input asp-for="ImageFile" type="file" class="form-file" accept=".jpg,.jpeg,.png,.webp" />
                <span class="file-info">JPG, JPEG, PNG və WEBP — maksimum 5 MB!</span>
                <span asp-validation-for="ImageFile" class="validation-message"></span>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Authors" asp-action="AuthorIndex" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i>
                <span>Ləğv et</span>
            </a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

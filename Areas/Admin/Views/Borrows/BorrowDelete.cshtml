@* ~/Areas/Admin/Views/Borrows/BorrowDelete.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.BorrowVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "İcarəni Sil";
    string statusClass = Model.BorrowStatus switch
    {
        "Aktiv" => "active",
        "Gecikir" => "overdue",
        _ => "deactive"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Delete.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div>
                <span class="content-label">İcarələr</span>
                <h1 class="content-title">İcarəni Sil</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Borrows" asp-action="BorrowIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Borrows" asp-action="BorrowDelete" asp-route-id="@Model.BorrowId" method="post" class="transaction-form">
        <!-- FORM-SECTION START -->
        <div class="form-section">
            <!-- DELETE-WARNING START -->
            <div class="delete-warning">
                <div class="warning-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="warning-content">
                    <h2>İcarəni silmək istədiyinizdən əminsiniz?</h2>
                    <p>Bu əməliyyat geri qaytarıla bilməz! İcarəni silməzdən əvvəl məlumatları yoxlayın.</p>
                </div>
            </div>
            <!-- DELETE-WARNING END -->

            <!-- CONTENT-DATA START (icarələrin şəkli olmadığı üçün tək sütun) -->
            <div class="content-data" style="grid-template-columns: 1fr;">
                <!-- CONTENT-DETAILS START -->
                <div class="content-details">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-hashtag"></i>
                            İcarə ID
                        </span>

                        <span class="detail-value">
                            @Model.BorrowId
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-user"></i>
                            İstifadəçi
                        </span>

                        <span class="detail-value">
                            @Model.UserFullName (@Model.UserUsername)
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-book"></i>
                            Kitab
                        </span>

                        <span class="detail-value">
                            @Model.BookName
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-barcode"></i>
                            ISBN
                        </span>

                        <span class="detail-value">
                            @Model.BookIsbn
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar-plus"></i>
                            İcarə tarixi
                        </span>

                        <span class="detail-value">
                            @Model.BorrowDate.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar-day"></i>
                            Qaytarılma müddəti
                        </span>

                        <span class="detail-value">
                            @Model.BorrowDueDate.ToString("dd.MM.yyyy")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-calendar-check"></i>
                            Qaytarılma tarixi
                        </span>

                        <span class="detail-value">
                            @(Model.BorrowReturnDate.HasValue ? Model.BorrowReturnDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-circle-check"></i>
                            Status
                        </span>

                        <span class="detail-value">
                            <span class="status-is-active @statusClass">@Model.BorrowStatus</span>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="fa-solid fa-money-bill"></i>
                            Cərimə
                        </span>

                        <span class="detail-value">
                            @(Model.FineAmount.HasValue ? Model.FineAmount.Value.ToString("0.00") + " AZN" : "-")
                        </span>
                    </div>
                </div>
                <!-- CONTENT-DETAILS END -->
            </div>
            <!-- CONTENT-DATA END -->

            <!-- DELETE-MESSAGE START -->
            <div class="delete-message">
                <i class="fa-solid fa-circle-info"></i>
                <span>İcarəyə bağlı cərimə mövcuddursa, icarə silinməyəcək!</span>
            </div>
            <!-- DELETE-MESSAGE END -->
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Borrows" asp-action="BorrowIndex" class="btn-cancel">Ləğv et</a>

            <button type="submit" class="btn-delete">
                <i class="fa-solid fa-trash"></i>
                <span>İcarəni sil</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

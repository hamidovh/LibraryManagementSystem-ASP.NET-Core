@* ~/Areas/Admin/Views/Categories/CategoryEdit.cshtml: *@

@model LibraryManagementSystem.Models.ViewModels.CategoryVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kateqoriyanı Redaktə Et";
    var currentImage = Model.TblCategoryImages?.OrderBy(i => i.ImageSortOrder).FirstOrDefault();
    string? imagePath = null;
    if (currentImage != null && !string.IsNullOrWhiteSpace(currentImage.ImagePath))
    {
        imagePath = Url.Content("~/Uploads/" + currentImage.ImagePath);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Images.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <div class="content-title-area">
            <div class="content-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div>
                <span class="content-label">Kateqorİyalar</span>
                <h1 class="content-title">Kateqoriyanı Redaktə Et</h1>
            </div>
        </div>

        <!-- BTN-BACK START -->
        <a asp-area="Admin" asp-controller="Categories" asp-action="CategoryIndex" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Geri</span>
        </a>
        <!-- BTN-BACK END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <partial name="_Messages" />

    <!-- TRANSACTION-FORM START -->
    <form asp-area="Admin" asp-controller="Categories" asp-action="CategoryEdit" asp-route-id="@Model.CategoryId" method="post" enctype="multipart/form-data" class="transaction-form">
        <!-- Kateqoriya ID-si POST zamanı modelə göndərilir: -->
        <input asp-for="CategoryId" type="hidden" />
        
        <!-- Controller-dən gələn "Heç bir dəyişiklik edilməyib!" xəbərdarlığı: -->
        <div asp-validation-summary="ModelOnly" class="validation-message warning-message"></div>

        <!-- FORM-SECTION START -->
        <div class="form-section">
            <div class="section-title">
                <i class="fa-solid fa-layer-group"></i>
                <span>Kateqoriya məlumatları</span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryName" class="form-label">Kateqoriya adı:</label>
                <input asp-for="CategoryName" class="form-input" placeholder="Kateqoriya adını daxil edin..." />
                <span asp-validation-for="CategoryName" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryDescription" class="form-label">Kateqoriya haqqında:</label>
                <textarea asp-for="CategoryDescription" class="form-textarea" placeholder="Kateqoriya haqqında məlumat daxil edin..."></textarea>
                <span asp-validation-for="CategoryDescription" class="validation-message"></span>
            </div>

            <div class="form-group form-group-inline">
                <label asp-for="CategoryIsActive" class="form-label">Status:</label>
                <label class="status-checkbox">
                    <input asp-for="CategoryIsActive" />
                    <span>Aktiv</span>
                </label>
                <span asp-validation-for="CategoryIsActive" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Mövcud şəkil:</label>
                @if (!string.IsNullOrWhiteSpace(imagePath))
                {
                    <div class="current-image">
                        <img src="@imagePath" alt="@Model.CategoryName" />
                    </div>

                    <label class="status-checkbox delete-checkbox">
                        <input asp-for="DeleteImage" />
                        <span>Mövcud şəkli sil</span>
                    </label>

                }
                else
                {
                    <div class="no-image">
                        <i class="fa-solid fa-image"></i>
                        <span>Şəkil yoxdur</span>
                    </div>
                }
            </div>

            <div class="form-group">
                <label asp-for="ImageFile" class="form-label">Yeni şəkil:</label>
                <input asp-for="ImageFile" type="file" class="form-file" accept=".jpg,.jpeg,.png,.webp" />
                <span class="file-info">Yeni şəkil seçsəniz, mövcud şəkil yenisi ilə əvəz olunacaq. JPG, JPEG, PNG və WEBP — maksimum 5 MB!</span>
                <span asp-validation-for="ImageFile" class="validation-message"></span>
            </div>
        </div>
        <!-- FORM-SECTION END -->

        <!-- FORM-ACTIONS START -->
        <div class="form-actions">
            <a asp-area="Admin" asp-controller="Categories" asp-action="CategoryIndex" class="btn-cancel">Ləğv et</a>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i>
                <span>Dəyişiklikləri yadda saxla</span>
            </button>
        </div>
        <!-- FORM-ACTIONS END -->
    </form>
    <!-- TRANSACTION-FORM END -->
</div>
<!-- CONTENT-CONTAINER END -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

@* ~/Areas/Admin/Views/Authors/AuthorIndex.cshtml: *@

@model IEnumerable<LibraryManagementSystem.Models.ViewModels.AuthorVM>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Müəlliflər";
    string sortOrder = ViewBag.SortOrder;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

@section Styles {
    <link rel="stylesheet" href="~/AdminControllerCSSs/Content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminControllerCSSs/Modal.css" asp-append-version="true" />
}

<!-- CONTENT-CONTAINER START -->
<div class="content-container">
    <!-- CONTENT-HEADER START -->
    <div class="content-header">
        <h1 class="content-title">Müəlliflər</h1>

        <!-- CONTENT-FILTER START -->
        <div class="content-filter">
            <form asp-area="Admin" asp-controller="Authors" asp-action="AuthorIndex" method="get">
                <select id="sortOrder" name="sortOrder" class="content-filter-select" onchange="this.form.submit()">
                    <option value="date_desc" selected="@(ViewBag.SortOrder == "date_desc")">Yenidən köhnəyə</option>
                    <option value="date_asc" selected="@(ViewBag.SortOrder == "date_asc")">Köhnədən yeniyə</option>
                    <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc")">A-dan Z-yə</option>
                    <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc")">Z-dən A-ya</option>
                </select>
            </form>
        </div>
        <!-- CONTENT-FILTER END -->

        <!-- BTN-CREATE START -->
        <a class="btn-create" asp-area="Admin" asp-controller="Authors" asp-action="AuthorCreate">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Müəllif</span>
        </a>
        <!-- BTN-CREATE END -->
    </div>
    <!-- CONTENT-HEADER END -->

    <!-- Uğur və xəta mesajları (Success, DeleteError, Error): -->
    <partial name="_Messages" />

    <!-- CONTENT-LIST START -->
    <div class="content-list">
        @if (Model != null && Model.Any())
        {
            foreach (var author in Model)
            {
                var image = author.TblAuthorImages?.OrderBy(i => i.ImageSortOrder).FirstOrDefault();
                string? imagePath = null;
                if (image != null && !string.IsNullOrWhiteSpace(image.ImagePath))
                {
                    imagePath = Url.Content("~/Uploads/" + image.ImagePath);
                }
                <!-- CONTENT-CARD START -->
                <div class="content-card">
                    <!-- CONTENT-INFO START -->
                    <div class="content-info">
                        <!-- CONTENT-IMAGE START -->
                        <div class="content-image">
                            @if (!string.IsNullOrWhiteSpace(imagePath))
                            {
                                <img src="@imagePath" alt="@author.AuthorFullName" />
                            }
                            else
                            {
                                <i class="fa-solid fa-user-pen"></i>
                            }
                        </div>
                        <!-- CONTENT-IMAGE END -->

                        <!-- CONTENT-NAME-AREA START -->
                        <div class="content-name-area">
                            <span class="content-label">Müəllİf</span>

                            <h2 class="content-name">@author.AuthorFullName</h2>
                        </div>
                        <!-- CONTENT-NAME-AREA END -->
                    </div>
                    <!-- CONTENT-INFO END -->

                    <!-- CONTENT-ACTIONS START -->
                    <div class="content-actions">
                        <!-- BTN-DETAILS (popup-ı açan button) START -->
                        <button type="button" class="btn-details" title="Ətraflı məlumat"
                                data-author-id="@author.AuthorId"
                                data-author-name="@author.AuthorName"
                                data-author-surname="@author.AuthorSurname"
                                data-author-info="@author.AuthorInfo"
                                data-author-is-active="@author.AuthorIsActive"
                                data-author-created-date="@author.AuthorCreatedDate.ToString("dd.MM.yyyy HH:mm")"
                                data-author-updated-date="@(author.AuthorUpdatedDate.HasValue? author.AuthorUpdatedDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")"
                                data-author-image="@imagePath">

                            <i class="fa-solid fa-eye"></i>

                        </button>
                        <!-- BTN-DETAILS (popup-ı açan button) END -->

                        <!-- BTN-EDIT START -->
                        <a asp-area="Admin" asp-controller="Authors" asp-action="AuthorEdit" asp-route-id="@author.AuthorId" class="btn-edit" title="Redaktə et">
                            <i class="fa-solid fa-pen"></i>
                            <span>Redaktə Et</span>
                        </a>
                        <!-- BTN-EDIT END -->

                        <!-- BTN-DELETE START -->
                        <a asp-area="Admin" asp-controller="Authors" asp-action="AuthorDelete" asp-route-id="@author.AuthorId" class="btn-delete" title="Sil">
                            <i class="fa-solid fa-trash"></i>
                            <span>Sil</span>
                        </a>
                        <!-- BTN-DELETE END -->
                    </div>
                    <!-- CONTENT-ACTIONS END -->
                </div>
                <!-- CONTENT-CARD END -->
            }
        }
        else
        {
            <div class="empty-message">
                <i class="fa-solid fa-folder-open"></i>
                <span>Heç bir müəllif tapılmadı!</span>
            </div>
        }
    </div>
    <!-- CONTENT-LIST END -->

    <!-- PAGINATION START -->
    <partial name="_Pagination" model="@(new PaginationVM
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        PageUrl = p => Url.Action("AuthorIndex", "Authors", new { area = "Admin", page = p, sortOrder })!
    })" />
    <!-- PAGINATION END -->
</div>
<!-- CONTENT-CONTAINER END -->

<!-- CONTENT-MODAL START -->
<div class="content-modal" id="authorModal">
    <div class="modal-container" id="modalContainer"></div>

    <!-- CONTENT-POPUP START -->
    <div class="content-popup">
        <!-- POPUP-HEADER START -->
        <div class="popup-header">
            <div class="popup-title-area">
                <div class="popup-icon">
                    <i class="fa-solid fa-user-pen"></i>
                </div>

                <div>
                    <span class="popup-label">Müəllİf məlumatları</span>
                    <h2 id="popupAuthorTitle">Müəllif</h2>
                </div>
            </div>

            <button type="button" class="popup-close" id="popupClose" title="Bağla">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <!-- POPUP-HEADER END -->

        <!-- POPUP-BODY START -->
        <div class="popup-body">
            <!-- POPUP-IMAGE-AREA START -->
            <div class="popup-image-area">
                <div class="popup-image-icon" id="popupImageIcon">
                    <i class="fa-solid fa-user-pen"></i>
                </div>

                <img id="popupAuthorImage" class="popup-content-image" src="" alt="Müəllif şəkli" />
            </div>
            <!-- POPUP-IMAGE-AREA END -->

            <!-- POPUP-DETAILS START -->
            <div class="popup-details">
                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-hashtag"></i>
                        Müəllif ID
                    </span>

                    <span class="detail-value" id="popupAuthorId">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-user"></i>
                        Müəllifin adı
                    </span>

                    <span class="detail-value" id="popupAuthorName">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-user"></i>
                        Müəllifin soyadı
                    </span>

                    <span class="detail-value" id="popupAuthorSurname">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-align-left"></i>
                        Müəllif haqqında
                    </span>

                    <span class="detail-value" id="popupAuthorInfo">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-circle-check"></i>
                        Status
                    </span>

                    <span class="detail-value">
                        <span id="popupAuthorIsActive" class="popup-is-active">
                            -
                        </span>
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-calendar-plus"></i>
                        Yaradılma tarixi
                    </span>

                    <span class="detail-value" id="popupAuthorCreatedDate">
                        -
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">
                        <i class="fa-solid fa-calendar-check"></i>
                        Son yenilənmə tarixi
                    </span>

                    <span class="detail-value" id="popupAuthorUpdatedDate">
                        -
                    </span>
                </div>
            </div>
            <!-- POPUP-DETAILS END -->
        </div>
        <!-- POPUP-BODY END -->
    </div>
    <!-- CONTENT-POPUP END -->
</div>
<!-- CONTENT-MODAL END -->

@section Scripts
{    
    <script src="~/AdminControllerJSs/AuthorIndex.js"></script>
}
